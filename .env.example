# Copy to .env.local for local dev. In Vercel: Project -> Settings -> Environment Variables.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Optional: saves employer lists, searches and chats. Leave blank to run without storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional model overrides
# CHAT_MODEL=claude-sonnet-5-5
# EXTRACT_MODEL=claude-haiku-4-5-20251001

# Optional: Adzuna job listings (powers Top contenders). Free key at developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
